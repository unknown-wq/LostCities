# Built artifacts are never committed — releases are published on GitHub Releases and the
# jar is reproducible from source with `cd lostbuildings && ./gradlew build`.
dist/

# Gradle / IDE leftovers that can appear at the repo root
.gradle/
build/
*.class

# Bootstrapping Minecraft in a unit test writes a server log directory next to the module.
# It is regenerated by every test run, so it is litter rather than output.
logs/

# runServer's world and server.properties
run/

# Agent worktrees (transient)
.claude/worktrees/
